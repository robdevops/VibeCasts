+package expo.modules.audio.service
+
+/**
+ * What the headset / Bluetooth / lock-screen transport buttons do. Set from the app
+ * (`setHeadsetControls`), read by the media session's player wrapper.
+ */
+object HeadsetControls {
+  const val NONE = "none"
+  const val SEEK = "seek"
+  const val EPISODE = "episode"
+  const val TOGGLE = "toggle"
+
+  /** Action for the "next track" button, "previous track" button, fast-forward, rewind: NONE, SEEK or EPISODE. */
+  @Volatile var skipForward: String = SEEK
+  @Volatile var skipBack: String = SEEK
+  @Volatile var seekForward: String = SEEK
+  @Volatile var seekBack: String = SEEK
+
+  /** Play/pause button: TOGGLE or NONE. */
+  @Volatile var playPause: String = TOGGLE
+
+  @Volatile var forwardMs: Long = 30_000L
+  @Volatile var backMs: Long = 15_000L
+}
